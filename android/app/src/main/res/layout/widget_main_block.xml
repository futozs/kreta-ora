<?xml version="1.0" encoding="utf-8"?>
<!--
    The lesson that matters now, as the app draws it: number, name, times,
    a countdown the launcher ticks by itself, and a progress bar.
    Widgets can not use the app's own font files, so this uses the phone's
    font at its heaviest weight for the same weight contrast.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/main_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_fill" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="15dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/main_number"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:textFontWeight="800"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:paddingTop="2dp"
                android:textColor="@color/widget_ink"
                android:textSize="26sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/main_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                android:textFontWeight="800"
                android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:lineSpacingMultiplier="0.92"
                    android:maxLines="2"
                    android:textColor="@color/widget_ink"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/main_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink_dim"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/main_times"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/main_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                android:textFontWeight="800"
                android:textStyle="bold"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/widget_ink"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/main_end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/widget_ink_dim"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Takes up whatever height is left, so the countdown sits at the bottom. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <Chronometer
                android:id="@+id/main_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:textFontWeight="800"
                android:textStyle="bold"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:letterSpacing="-0.03"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:textSize="50sp" />

            <TextView
                android:id="@+id/main_static"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:textFontWeight="800"
                android:textStyle="bold"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:letterSpacing="-0.03"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:textSize="50sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/main_count_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/widget_ink_dim"
                android:textSize="15sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/main_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="12dp"
            android:max="1000"
            android:progressDrawable="@drawable/widget_progress" />
    </LinearLayout>
</FrameLayout>
