<?xml version="1.0" encoding="utf-8"?>
<!--
    When the next school day starts: the time set as large as the widget
    allows, the first lesson, and the day's shape as a bar of subject colours.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="16dp"
    android:paddingEnd="18dp"
    android:paddingBottom="18dp">

    <TextView
        android:id="@+id/ds_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/widget_text_dim"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/ds_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
                android:textFontWeight="800"
                android:textStyle="bold"
        android:fontFeatureSettings="tnum"
        android:includeFontPadding="false"
        android:letterSpacing="-0.04"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="66sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/ds_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
                android:textFontWeight="800"
                android:textStyle="bold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/ds_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:maxLines="1"
        android:textColor="@color/widget_text_dim"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/ds_bar"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginTop="12dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <TextView
        android:id="@+id/ds_span"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/widget_text_dim"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/ds_alert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/widget_danger"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
